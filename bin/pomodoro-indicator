#!/usr/bin/env python3
"""Top-panel indicator process (AppIndicator beside system clock)."""
import os
import sys
import time
import subprocess
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PROJECT_ROOT))

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import Gtk, GLib

from pomodoro.ipc import IPCClient
from pomodoro.indicator import PanelAppIndicator


def ensure_daemon_running(client: IPCClient):
    if not client.is_server_running():
        daemon_bin = PROJECT_ROOT / "bin" / "pomodoro-daemon"
        subprocess.Popen([sys.executable, str(daemon_bin)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(50):
            time.sleep(0.05)
            if client.is_server_running():
                break


def main():
    client = IPCClient()
    ensure_daemon_running(client)

    app_indicator = PanelAppIndicator(ipc_client=client)

    # Subscribe to daemon push events
    def on_ipc_event(msg):
        event = msg.get("event")
        data = msg.get("data")
        if event in ("tick", "state_change") and data:
            GLib.idle_add(app_indicator.update_status, data)
        elif event == "tasks_changed":
            if app_indicator.popup.get_visible():
                GLib.idle_add(app_indicator.popup.refresh_tasks)
        elif event == "settings_changed":
            if app_indicator.popup.get_visible():
                GLib.idle_add(app_indicator.popup.refresh_settings)

    client.subscribe(on_ipc_event)

    Gtk.main()


if __name__ == "__main__":
    main()
