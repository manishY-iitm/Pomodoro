#!/usr/bin/env python3
"""Main application launcher for Pomodoro Productivity Clock.
Fully cross-platform for Windows, macOS, and Linux.
"""
import os
import sys
import time
import signal
import argparse
import subprocess
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PROJECT_ROOT))

from pomodoro.config import PID_FILE, INDICATOR_PID_FILE, SOCKET_PATH, PORT_FILE, IS_WINDOWS
from pomodoro.ipc import IPCClient

DAEMON_BIN = PROJECT_ROOT / "bin" / "pomodoro-daemon"
INDICATOR_BIN = PROJECT_ROOT / "bin" / "pomodoro-indicator"
CTL_BIN = PROJECT_ROOT / "bin" / "pomodoroctl"


def is_running(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def start_daemon_if_needed():
    client = IPCClient()
    if not client.is_server_running():
        if IS_WINDOWS:
            creationflags = getattr(subprocess, "CREATE_NO_WINDOW", 0) | getattr(subprocess, "DETACHED_PROCESS", 0)
            subprocess.Popen([sys.executable, str(DAEMON_BIN)], creationflags=creationflags)
        else:
            subprocess.Popen(
                [sys.executable, str(DAEMON_BIN)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        for _ in range(40):
            time.sleep(0.05)
            if client.is_server_running():
                break


def stop_all():
    # 1. Stop daemon
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
            os.kill(pid, signal.SIGTERM)
        except Exception:
            pass
        PID_FILE.unlink(missing_ok=True)

    # 2. Stop indicator
    if INDICATOR_PID_FILE.exists():
        try:
            pid = int(INDICATOR_PID_FILE.read_text().strip())
            os.kill(pid, signal.SIGTERM)
        except Exception:
            pass
        INDICATOR_PID_FILE.unlink(missing_ok=True)

    # Fallback process killing on POSIX
    if not IS_WINDOWS:
        try:
            subprocess.run(["pkill", "-f", "pomodoro-indicator"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    SOCKET_PATH.unlink(missing_ok=True)
    PORT_FILE.unlink(missing_ok=True)
    print("Pomodoro Clock stopped.")


def main():
    parser = argparse.ArgumentParser(description="Pomodoro Productivity Clock")
    parser.add_argument("--stop", action="store_true", help="Stop Pomodoro clock and daemon")
    parser.add_argument("--restart", action="store_true", help="Restart Pomodoro clock")
    parser.add_argument("--status", action="store_true", help="Check status")
    parser.add_argument("--menu", action="store_true", help="Open controls popup")
    parser.add_argument("--daemon-only", action="store_true", help="Start only the background timer daemon")
    parser.add_argument("--qt", action="store_true", help="Force PyQt GUI on any platform")
    args, unknown = parser.parse_known_args()

    if args.stop:
        stop_all()
        return

    if args.restart:
        stop_all()
        time.sleep(0.5)

    if args.status:
        subprocess.run([sys.executable, str(CTL_BIN), "status"])
        return

    # Start background daemon
    start_daemon_if_needed()

    if args.daemon_only:
        print("Pomodoro daemon is running.")
        return

    # Check if indicator is already running
    if INDICATOR_PID_FILE.exists():
        try:
            ind_pid = int(INDICATOR_PID_FILE.read_text().strip())
            if is_running(ind_pid) and ind_pid != os.getpid():
                if not args.restart:
                    print(f"Pomodoro indicator is already running (PID {ind_pid}).")
                    sys.exit(0)
        except Exception:
            INDICATOR_PID_FILE.unlink(missing_ok=True)

    # Launch indicator
    extra_flags = ["--qt"] if args.qt else []
    if IS_WINDOWS:
        subprocess.call([sys.executable, str(INDICATOR_BIN)] + extra_flags)
    else:
        os.execv(sys.executable, [sys.executable, str(INDICATOR_BIN)] + extra_flags)


if __name__ == "__main__":
    main()
